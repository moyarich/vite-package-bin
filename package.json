{
  "name": "@moyarich/vite-plugin-package-bin",
  "version": "0.1.0",
  "description": "Vite plugin for building package.json bin entries as standalone Node.js executables.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "vite": ">=8.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/vite-package-bin.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  }
}
